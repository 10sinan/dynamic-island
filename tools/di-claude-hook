#!/usr/bin/env python3
"""di-claude-hook — Claude Code hook that tells the Dynamic Island extension
when you send Claude a prompt (UserPromptSubmit), when it finishes (Stop)
or waits for you (Notification).

Claude Code runs it with the hook's JSON on stdin. It never blocks or fails
Claude: whatever happens it exits 0 within about a second.

Install with:  di-config claude-hooks install
"""
import json
import os
import re
import subprocess
import sys

DEST = "org.gnome.Shell"
PATH = "/org/gnome/Shell/Extensions/DynamicIsland"
METHOD = "org.gnome.Shell.Extensions.DynamicIsland.ClaudeEvent"
PERMISSION_METHOD = "org.gnome.Shell.Extensions.DynamicIsland.ClaudePermission"
PERMISSION_WAIT_S = 50   # Claude Code's hook limit is set to 55 s by `di-config claude-hooks install`


def ancestors(pid=None, limit=40):
    """This process and its parents (VS Code / the terminal is one of them)."""
    out, pid = [], pid or os.getpid()
    for _ in range(limit):
        if pid <= 1:
            break
        out.append(pid)
        try:
            with open(f"/proc/{pid}/stat", "rb") as f:
                stat = f.read().decode(errors="replace")
            pid = int(stat[stat.rindex(")") + 2:].split()[1])   # field 4: ppid (after "comm")
        except (OSError, ValueError, IndexError):
            break
    return out


def build_args(payload, pids):
    """Hook JSON -> gdbus arguments, or None if the event is not one we show."""
    event = str(payload.get("hook_event_name", ""))
    if event == "Stop":
        kind = "done"
    elif event == "Notification":
        kind = "waiting"
    elif event == "UserPromptSubmit":
        kind = "working"
    else:
        return None
    cwd = str(payload.get("cwd") or os.getcwd())
    project = redact(os.path.basename(cwd.rstrip("/")) or cwd)
    message = redact(str(payload.get("message", "")).replace("\n", " "))[:200]
    return ["gdbus", "call", "--session", "--timeout", "1",
            "--dest", DEST, "--object-path", PATH, "--method", METHOD,
            kind, project, message, ",".join(map(str, pids)), str(payload.get("session_id", ""))[:80]]


MASK = "*****"
# a value: quoted (kept whole) or up to the next space / quote / separator
_VALUE = r"""(?:"[^"]*"|'[^']*'|[^\s"'&;,)]+)"""
_NAME = (r"[A-Za-z0-9_.-]*(?:password|passwd|passphrase|pwd|secret|token(?!s)|api[ _-]?key|apikey|"
         r"access[ _-]?key|private[ _-]?key|credential)[A-Za-z0-9_-]*")
_FLAG = (r"--(?:password|passwd|pass|passphrase|token|secret|api[-_]?key|access[-_]?token|auth[-_]?token|"
         r"client[-_]?secret|private[-_]?key)")

# (pattern, replacement): only the secret itself becomes MASK, the rest of the command stays readable.
_REDACT = [(re.compile(p, re.I) if i else re.compile(p), r) for i, (p, r) in enumerate([
    # 0  well-known token shapes (case-sensitive): the whole token is the secret
    (r"\bsk-ant-[A-Za-z0-9_-]{8,}|\bsk-[A-Za-z0-9]{20,}|\bgithub_pat_[A-Za-z0-9_]{20,}|\bgh[pousr]_[A-Za-z0-9]{20,}"
     r"|\bglpat-[A-Za-z0-9_-]{16,}|\bxox[abprs]-[A-Za-z0-9-]{10,}|\b(?:AKIA|ASIA|AGPA|AIDA|AROA|ANPA)[A-Z0-9]{16}\b"
     r"|\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{4,}", MASK),
    # 1  Authorization: [Scheme] value   (header in a -H argument, an env var, JSON ...)
    (r"(\bauthorization[\"']?\s*[:=]\s*(?:(?:bearer|basic|token|digest)\s+)?)" + _VALUE, r"\1" + MASK),
    # 2  Bearer value anywhere else
    (r"(\bbearer\s+)[^\s\"'&;,)]{6,}", r"\1" + MASK),
    # 3  --password value / --token value  (--password=value is rule 4); a following flag is not a value
    (r"(" + _FLAG + r"\s+)(?!-)" + _VALUE, r"\1" + MASK),
    # 4  password=..., GITHUB_TOKEN=..., "api_key": "...", x-api-key: ..., --token=...
    (r"(\b" + _NAME + r"[\"']?\s*[=:]\s*)" + _VALUE, r"\1" + MASK),
    # 5  scheme://user:password@host
    (r"(://[^/\s:@]+:)[^@\s/]+(@)", r"\1" + MASK + r"\2"),
    # 6  curl -u user:password
    (r"(\s-u\s+[^\s:]+:)\S+", r"\1" + MASK),
])]


def redact(text):
    """Mask secrets in a command / message before it leaves this process (D-Bus, the island's window, logs)."""
    text = str(text)
    for pattern, repl in _REDACT:
        text = pattern.sub(repl, text)
    return text


def summarize(tool, tool_input):
    """What the user is asked about, in one short line (never hidden, only cut with an ellipsis)."""
    ti = tool_input if isinstance(tool_input, dict) else {}
    if tool == "Bash":
        text = str(ti.get("command", ""))
    elif tool in ("Edit", "Write", "MultiEdit", "NotebookEdit", "Read"):
        text = str(ti.get("file_path") or ti.get("notebook_path") or "")
    elif tool in ("WebFetch", "WebSearch"):
        text = str(ti.get("url") or ti.get("query") or "")
    else:
        text = ""
    # mask first: cutting at 120 characters must not leave half a secret on screen
    text = " ".join(redact(text).split())
    return text if len(text) <= 120 else text[:119] + "…"


def build_permission_args(payload, pids):
    """PermissionRequest JSON -> gdbus call that waits for the user's click, or None.

    None also when the island could not show the whole request: an empty
    summary (a tool we cannot describe) or a cut one (a long command whose
    end would be hidden). Then the user decides in Claude Code's own dialog,
    which shows everything; the island must never ask for a blind Allow."""
    if str(payload.get("hook_event_name", "")) != "PermissionRequest":
        return None
    cwd = str(payload.get("cwd") or os.getcwd())
    project = redact(os.path.basename(cwd.rstrip("/")) or cwd)
    tool = redact(str(payload.get("tool_name", "")))[:60]
    summary = summarize(tool, payload.get("tool_input"))
    if not summary or summary.endswith("…"):
        return None
    return ["gdbus", "call", "--session", "--timeout", str(PERMISSION_WAIT_S),
            "--dest", DEST, "--object-path", PATH, "--method", PERMISSION_METHOD,
            project, tool, summary, ",".join(map(str, pids)),
            str(payload.get("session_id", ""))[:80]]


def decision_output(answer):
    """The island's answer -> Claude Code's hook output. Anything but a clear
    allow/deny prints nothing, so Claude Code shows its normal permission dialog.
    This script NEVER allows anything by itself."""
    if answer == "allow":
        decision = {"behavior": "allow"}
    elif answer == "deny":
        decision = {"behavior": "deny", "message": "Denied from Dynamic Island", "interrupt": False}
    else:
        return None
    return json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": decision}})


def parse_gdbus_string(out):
    """gdbus prints  ('allow',)  for a (s) reply."""
    out = out.strip()
    if out.startswith("(") and out.endswith(")"):
        out = out[1:-1].rstrip(",").strip()
    return out.strip("'\"")


def main():
    try:
        payload = json.loads(sys.stdin.read() or "{}")
        if not isinstance(payload, dict):
            return
        if payload.get("hook_event_name") == "PermissionRequest":
            args = build_permission_args(payload, ancestors())
            if not args:
                return   # nothing printed: Claude Code shows its own dialog
            r = subprocess.run(args, capture_output=True, text=True, timeout=PERMISSION_WAIT_S + 3, check=False)
            if r.returncode == 0:
                out = decision_output(parse_gdbus_string(r.stdout))
                if out:
                    print(out)
            return
        args = build_args(payload, ancestors())
        if args:
            subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2, check=False)
    except Exception:   # noqa: BLE001 — a hook must never break Claude
        pass


if __name__ == "__main__":
    main()
    sys.exit(0)
