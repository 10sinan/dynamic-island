#!/usr/bin/env python3
"""di-config — Dynamic Island ayarları için terminal arayüzü.

Kullanım:
    di-config                     etkileşimli arayüz (curses)
    di-config list                tüm ayarları yazdır
    di-config get <anahtar>
    di-config set <anahtar> <değer>
    di-config reset [anahtar]     bir ayarı ya da hepsini varsayılana döndür
    di-config claude-calibrate <yüzde>
                                  Claude kartını /usage'daki oturum yüzdesine göre ayarla
    di-config claude-hooks install|remove|status
                                  Claude Code bildirimleri için hook'ları kur / kaldır

Değişiklikler GSettings'e yazılır; eklenti bunları dinler ve island'ları
oturumu kapatmadan anında yeniden kurar.
"""
import curses
import locale
import os
import sys

import gi

gi.require_version("Gio", "2.0")
gi.require_version("GLib", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

UUID = "dynamic-island@local"
SCHEMA_ID = "org.gnome.shell.extensions.dynamic-island"

# ----------------------------------------------------------------- schema


def _schema_dirs():
    here = os.path.dirname(os.path.realpath(__file__))
    yield os.path.join(here, "..", UUID, "schemas")
    data = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
    yield os.path.join(data, "gnome-shell", "extensions", UUID, "schemas")


def open_settings():
    for d in _schema_dirs():
        if os.path.exists(os.path.join(d, "gschemas.compiled")):
            src = Gio.SettingsSchemaSource.new_from_directory(
                os.path.abspath(d), Gio.SettingsSchemaSource.get_default(), False)
            schema = src.lookup(SCHEMA_ID, False)
            if schema:
                return Gio.Settings.new_full(schema, None, None), schema
    sys.exit("di-config: derlenmiş şema bulunamadı. Önce ./install.sh çalıştır.")


