ALL_ITEMS = {item["key"]: item for _, items in TABS for item in items}


def key_range(schema, key):
    """(min, max) for integer keys, None otherwise."""
    rng = schema.get_key(key).get_range().unpack()
    if rng[0] == "range":
        return rng[1]
    return None


def write(settings, fn, key, value):
    getattr(settings, fn)(key, value)
    Gio.Settings.sync()  # flush to dconf now, the shell picks it up right away


# ----------------------------------------------------------------- CLI

def format_value(settings, key):
    v = settings.get_value(key).unpack()
    if isinstance(v, bool):
        return T("açık") if v else T("kapalı")
    if isinstance(v, list):
        return ", ".join(v) if v else T("(boş)")
    return str(v)


def cli(settings, schema, argv):
    global LANG
    LANG = settings.get_string("language") if schema.has_key("language") else "tr"
    cmd = argv[0]
    if cmd == "list":
        ordered = [k for k in ALL_ITEMS if schema.has_key(k)]
        ordered += [k for k in ("center-compact-modules",) if schema.has_key(k)]
        ordered += sorted(k for k in schema.list_keys() if k not in ordered)
        for k in ordered:
            label = T(ALL_ITEMS.get(k, {}).get("label", "panelde gösterilen metrikler"
                                             if k == "center-compact-modules" else ""))
            print(f"{k:24} = {format_value(settings, k):28} {label}")
    elif cmd == "get" and len(argv) == 2:
        print(settings.get_value(argv[1]).print_(False))
    elif cmd == "set" and len(argv) == 3:
        key, raw = argv[1], argv[2]
        if not schema.has_key(key):
            sys.exit(f"bilinmeyen anahtar: {key}")
        vtype = schema.get_key(key).get_value_type().dup_string()
        try:
            if vtype == "b":
                value = GLib.Variant("b", raw.lower() in ("1", "true", "yes", "on", "açık", "evet"))
            elif vtype == "i":
                value = GLib.Variant("i", int(raw))
            elif vtype == "as":
                if raw.strip().startswith("["):
                    value = GLib.Variant.parse(GLib.VariantType.new("as"), raw, None, None)
                else:
                    value = GLib.Variant("as", [s.strip() for s in raw.split(",") if s.strip()])
            else:
                value = GLib.Variant("s", raw)
        except (ValueError, GLib.Error) as e:
            sys.exit(f"geçersiz değer: {e}")
        if not schema.get_key(key).range_check(value):
            sys.exit(f"{key}: izin verilen aralığın dışında")
        settings.set_value(key, value)
        Gio.Settings.sync()
        print(f"{key} = {format_value(settings, key)}")
    elif cmd == "reset":
        keys = argv[1:] or schema.list_keys()
        for k in keys:
            settings.reset(k)
        Gio.Settings.sync()
        print("varsayılana döndürüldü: " + ", ".join(keys))
    else:
        print(__doc__)
        sys.exit(2)


