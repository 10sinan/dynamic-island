def nearest_256(hex_color):
    """Closest xterm-256 colour index for a #rrggbb string."""
    r, g, b = (int(hex_color[i:i + 2], 16) for i in (1, 3, 5))
    steps = [0, 95, 135, 175, 215, 255]

    def idx(c):
        return min(range(6), key=lambda i: abs(steps[i] - c))
    return 16 + 36 * idx(r) + 6 * idx(g) + idx(b)


class App:
    MIN_W, MIN_H = 60, 16

    def __init__(self, scr, settings, schema):
        self.scr, self.s, self.schema = scr, settings, schema
        self.tab = 0
        self.row = 0
        self.msg = ""
        curses.curs_set(0)
        curses.use_default_colors()
        self.colors = curses.has_colors()
        if self.colors:
            curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)    # selected tab / row
            curses.init_pair(2, curses.COLOR_CYAN, -1)                    # accents
            curses.init_pair(3, 8 if curses.COLORS > 8 else curses.COLOR_WHITE, -1)  # dim
            curses.init_pair(4, curses.COLOR_GREEN, -1)
        self.swatch_pair = 5

    # -- helpers
    def attr(self, n, extra=0):
        return (curses.color_pair(n) if self.colors else 0) | extra

    def items(self):
        return TABS[self.tab][1]

    def rows(self):
        """Selectable rows of the current tab: (item, module_id|None)."""
        out = []
        for item in self.items():
            if item["kind"] == "modules":
                for mid in self.module_order(item):
                    out.append((item, mid))
            else:
                out.append((item, None))
        return out

    def module_order(self, item):
        enabled = self.s.get_strv(item["key"])
        return enabled + [m for m in item["all"] if m not in enabled]

    def put(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and x < w:
            self.scr.addnstr(y, x, text, max(0, w - x - 1), attr)

    # -- drawing
    def draw(self):
        scr = self.scr
        global LANG
        LANG = self.s.get_string("language") if self.schema.has_key("language") else "tr"
        scr.erase()
        h, w = scr.getmaxyx()
        if w < self.MIN_W or h < self.MIN_H:
            self.put(0, 0, f"Terminal çok küçük ({w}x{h}). En az {self.MIN_W}x{self.MIN_H} gerekli.")
            scr.refresh()
            return

        self.put(0, 2, "Dynamic Island", self.attr(2, curses.A_BOLD))
        self.put(0, 17, T("· ayarlar"), self.attr(3))
        note = T("değişiklikler anında uygulanır")
        self.put(0, w - len(note) - 2, note, self.attr(3))

        x = 2
        for i, (name, _) in enumerate(TABS):
            label = f" {i + 1} {T(name)} "
            self.put(2, x, label, self.attr(1, curses.A_BOLD) if i == self.tab else self.attr(3))
            x += len(label) + 1
        self.put(3, 2, "─" * (w - 4), self.attr(3))

        rows = self.rows()
        self.row = max(0, min(self.row, len(rows) - 1))
        y = 5
        last_item = None
        for i, (item, mid) in enumerate(rows):
            if item["kind"] == "modules" and item is not last_item:
                self.put(y, 2, T(item["label"]), self.attr(2, curses.A_BOLD))
                if item.get("panel_key"):
                    self.put(y, w - 22, T("karo   panelde"), self.attr(3))
                y += 1
            last_item = item
            sel = i == self.row
            self.draw_row(y, w, item, mid, sel)
            y += 1

        help_text = T(rows[self.row][0]["help"]) if rows else ""
        self.put(h - 4, 2, "─" * (w - 4), self.attr(3))
        self.put(h - 3, 2, help_text, self.attr(0))
        if self.msg:
            self.put(h - 2, 2, self.msg, self.attr(4, curses.A_BOLD))
        keys = T("↑↓ gez  ←→ değiştir  Space aç/kapa  Tab/1-7 sekme  r varsayılan  R hepsi  q çık")
        self.put(h - 1, 2, keys, self.attr(3))
        scr.refresh()

    def draw_row(self, y, w, item, mid, sel):
        marker = "›" if sel else " "
        base = curses.A_REVERSE if sel else 0
        kind, key = item["kind"], item["key"]
        if kind == "modules":
            enabled = mid in self.s.get_strv(key)
            box = "[x]" if enabled else "[ ]"
            text = f"{marker} {box} {T(MODULE_NAMES.get(mid, mid))}"
            self.put(y, 2, text.ljust(w - 26), base | (0 if enabled else self.attr(3)))
            if item.get("panel_key"):
                if mid in COMPACT_CAPABLE:
                    on_panel = mid in self.s.get_strv(item["panel_key"])
                    self.put(y, w - 15, "[x]" if on_panel else "[ ]", base)
                else:
                    self.put(y, w - 15, " – ", base | self.attr(3))
            return

        label = f"{marker} {T(item['label'])}"
        self.put(y, 2, label.ljust(w - 30), base)
        vx = w - 28
        if kind == "bool":
            on = self.s.get_boolean(key)
            self.put(y, vx, T("● açık ") if on else T("○ kapalı"), self.attr(4 if on else 3, base))
        elif kind == "int":
            v = self.s.get_int(key)
            text = T(item.get("zero")) if v == 0 and item.get("zero") else f"{v} {item['unit']}"
            self.put(y, vx, f"◀ {text:>10} ▶", base)
        elif kind == "choice":
            v = self.s.get_string(key)
            text = T(dict(item["choices"]).get(v, v))
            self.put(y, vx, f"◀ {text} ▶", base)
        elif kind == "color":
            v = self.s.get_string(key)
            name = T(next((n for n, c in COLOR_PRESETS if c.lower() == v.lower()), "özel"))
            self.put(y, vx, f"◀ {v or '—'} {name} ▶", base)
            if v and self.colors and curses.COLORS >= 256:
                try:
                    curses.init_pair(self.swatch_pair, -1, nearest_256(v))
                    self.put(y, w - 6, "    ", curses.color_pair(self.swatch_pair))
                except curses.error:
                    pass

    # -- actions
    def change(self, delta):
        rows = self.rows()
        if not rows:
            return
        item, mid = rows[self.row]
        kind, key = item["kind"], item["key"]
        if kind == "bool":
            write(self.s, "set_boolean", key, not self.s.get_boolean(key))
        elif kind == "int":
            lo, hi = key_range(self.schema, key) or (0, 1 << 30)
            v = self.s.get_int(key) + delta * item["step"]
            write(self.s, "set_int", key, max(lo, min(hi, v)))
        elif kind == "choice":
            values = [c for c, _ in item["choices"]]
            cur = self.s.get_string(key)
            i = (values.index(cur) + (delta or 1)) % len(values) if cur in values else 0
            write(self.s, "set_string", key, values[i])
        elif kind == "color":
            presets = [c for _, c in COLOR_PRESETS]
            cur = self.s.get_string(key).lower()
            i = presets.index(cur) if cur in presets else -1
            write(self.s, "set_string", key, presets[(i + (delta or 1)) % len(presets)])
        elif kind == "modules":
            self.toggle_module(item, mid, item["key"])
            # the list re-sorts (enabled first); keep the cursor on this module
            rows = self.rows()
            self.row = next((i for i, (it, m) in enumerate(rows) if it is item and m == mid), self.row)
        self.msg = f"✓ {key} {T('güncellendi')}"

    def toggle_module(self, item, mid, key):
        cur = self.s.get_strv(key)
        if mid in cur:
            cur.remove(mid)
        else:
            # insert keeping the displayed order
            order = self.module_order(item)
            cur.append(mid)
            cur.sort(key=order.index)
        write(self.s, "set_strv", key, cur)

    def move_module(self, step):
        item, mid = self.rows()[self.row]
        if item["kind"] != "modules":
            return
        cur = self.s.get_strv(item["key"])
        if mid not in cur:
            self.msg = T("Önce Space ile modülü aç, sonra taşı.")
            return
        i = cur.index(mid)
        j = i + step
        if 0 <= j < len(cur):
            cur[i], cur[j] = cur[j], cur[i]
            write(self.s, "set_strv", item["key"], cur)
            self.row += step
            self.msg = f"✓ {mid} {T('taşındı')}"

    def toggle_panel(self):
        item, mid = self.rows()[self.row]
        if item["kind"] == "modules" and item.get("panel_key") and mid not in COMPACT_CAPABLE:
            self.msg = f"{T(MODULE_NAMES.get(mid, mid))} {T('panelde gösterilemez.')}"
            return
        if item["kind"] == "modules" and item.get("panel_key"):
            self.toggle_module(item, mid, item["panel_key"])
            self.msg = f"✓ {mid}: {T('panelde gösterim değişti')}"

    def edit_color(self):
        h, _ = self.scr.getmaxyx()
        self.put(h - 2, 2, " " * 60)
        self.put(h - 2, 2, T("Renk (#rrggbb): "), self.attr(2, curses.A_BOLD))
        curses.echo()
        curses.curs_set(1)
        try:
            raw = self.scr.getstr(h - 2, 18, 7).decode().strip()
        finally:
            curses.noecho()
            curses.curs_set(0)
        if len(raw) == 6 and not raw.startswith("#"):
            raw = "#" + raw
        try:
            int(raw[1:], 16)
            ok = len(raw) == 7 and raw.startswith("#")
        except ValueError:
            ok = False
        if ok:
            write(self.s, "set_string", "accent-color", raw.lower())
            self.msg = f"✓ {T('vurgu rengi')} {raw.lower()}"
        else:
            self.msg = T("Geçersiz renk. Örnek: #5ab8ff")

    def reset_current(self):
        item, _ = self.rows()[self.row]
        self.s.reset(item["key"])
        if item.get("panel_key"):
            self.s.reset(item["panel_key"])
        Gio.Settings.sync()
        self.msg = f"✓ {item['key']} {T('varsayılana döndü')}"

    def reset_all(self):
        for k in self.schema.list_keys():
            self.s.reset(k)
        Gio.Settings.sync()
        self.msg = T("✓ tüm ayarlar varsayılana döndü")

    def run(self):
        while True:
            self.draw()
            ch = self.scr.get_wch()
            self.msg = ""
            if ch in ("q", "Q", "\x1b"):
                return
            if ch in (curses.KEY_UP, "k"):
                self.row = max(0, self.row - 1)
            elif ch in (curses.KEY_DOWN, "j"):
                self.row = min(len(self.rows()) - 1, self.row + 1)
            elif ch in ("\t", curses.KEY_BTAB):
                self.tab = (self.tab + (1 if ch == "\t" else -1)) % len(TABS)
                self.row = 0
            elif isinstance(ch, str) and ch in "1234567":
                self.tab, self.row = int(ch) - 1, 0
            elif ch in (curses.KEY_RIGHT, "+", "l", "="):
                self.change(+1)
            elif ch in (curses.KEY_LEFT, "-", "h"):
                self.change(-1)
            elif ch == " ":
                self.change(0)
            elif ch in ("\n", curses.KEY_ENTER):
                item = self.rows()[self.row][0]
                if item["kind"] == "color":
                    self.edit_color()
                else:
                    self.change(+1)
            elif ch == "J":
                self.move_module(+1)
            elif ch == "K":
                self.move_module(-1)
            elif ch == "p":
                self.toggle_panel()
            elif ch == "r":
                self.reset_current()
            elif ch == "R":
                self.reset_all()
            elif ch == curses.KEY_RESIZE:
                pass


# ----------------------------------------------------------------- Claude Code hooks

CLAUDE_SETTINGS = os.path.expanduser("~/.claude/settings.json")
HOOK_EVENTS = ("UserPromptSubmit", "Stop", "Notification")


def hook_command():
    here = os.path.dirname(os.path.realpath(__file__))
    installed = os.path.expanduser("~/.local/bin/di-claude-hook")
    return installed if os.path.exists(installed) else os.path.join(here, "di-claude-hook")


def _is_ours(entry):
    return any(str(h.get("command", "")).endswith("di-claude-hook") for h in entry.get("hooks", []) if isinstance(h, dict))


def claude_hooks(action):
    """install / remove / status of the Stop + Notification hooks in ~/.claude/settings.json."""
    import json
    import shutil
    data = {}
    if os.path.exists(CLAUDE_SETTINGS):
        with open(CLAUDE_SETTINGS, encoding="utf-8") as f:
            data = json.load(f)
    hooks = data.get("hooks") or {}
    present = {ev: any(_is_ours(e) for e in hooks.get(ev, [])) for ev in HOOK_EVENTS}
    if action == "status":
        for ev in HOOK_EVENTS:
            print(f"{ev:13} {'kurulu' if present[ev] else 'yok'}")
        return
    if action == "install":
        cmd = hook_command()
        for ev in HOOK_EVENTS:
            if not present[ev]:
                hooks.setdefault(ev, []).append({"hooks": [{"type": "command", "command": cmd}]})
        msg = f"Claude Code hook'ları kuruldu: {cmd}"
    elif action == "remove":
        for ev in HOOK_EVENTS:
            kept = [e for e in hooks.get(ev, []) if not _is_ours(e)]
            if kept:
                hooks[ev] = kept
            else:
                hooks.pop(ev, None)
        msg = "Claude Code hook'ları kaldırıldı."
    else:
        sys.exit("kullanım: di-config claude-hooks install|remove|status")
    if hooks:
        data["hooks"] = hooks
    else:
        data.pop("hooks", None)
    os.makedirs(os.path.dirname(CLAUDE_SETTINGS), exist_ok=True)
    if os.path.exists(CLAUDE_SETTINGS):
        shutil.copy2(CLAUDE_SETTINGS, CLAUDE_SETTINGS + ".bak")
    tmp = CLAUDE_SETTINGS + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, CLAUDE_SETTINGS)
    print(msg)


def claude_window():
    """Current 5-hour Claude session from ~/.claude/projects (same rules as lib/claudeUsage.js)."""
    import calendar
    import json
    import time
    window = 5 * 3600
    now = time.time()
    since = now - window - 3600
    by_id = {}
    root = os.path.expanduser("~/.claude/projects")
    for dirpath, _dirs, files in os.walk(root):
        if dirpath[len(root):].count(os.sep) > 4:
            continue
        for name in files:
            path = os.path.join(dirpath, name)
            if not name.endswith(".jsonl") or os.path.getmtime(path) < since:
                continue
            with open(path, encoding="utf-8", errors="replace") as f:
                for line in f:
                    if '"usage"' not in line:
                        continue
                    try:
                        o = json.loads(line)
                        m, u = o["message"], o["message"]["usage"]
                        t = calendar.timegm(time.strptime(o["timestamp"][:19], "%Y-%m-%dT%H:%M:%S"))
                    except (ValueError, KeyError, TypeError):
                        continue
                    if not m.get("id") or t < since:
                        continue
                    cur = by_id.setdefault(m["id"], {"t": t, "input": 0, "output": 0, "cw": 0})
                    cur["t"] = min(cur["t"], t)
                    cur["input"] = max(cur["input"], int(u.get("input_tokens") or 0))
                    cur["output"] = max(cur["output"], int(u.get("output_tokens") or 0))
                    cur["cw"] = max(cur["cw"], int(u.get("cache_creation_input_tokens") or 0))
    start, last, used = None, 0, 0
    for e in sorted(by_id.values(), key=lambda e: e["t"]):
        if start is None or e["t"] >= start + window or e["t"] - last >= window:
            start, used = e["t"] // 3600 * 3600, 0
        used += e["input"] + e["output"] + e["cw"]
        last = e["t"]
    if start is None or now >= start + window:
        return 0
    return used


def claude_calibrate(settings, pct_text):
    try:
        pct = float(pct_text.replace(",", ".").rstrip("%"))
    except ValueError:
        sys.exit("kullanım: di-config claude-calibrate <yüzde>   (/usage'daki oturum yüzdesi, örn. 37)")
    used = claude_window()
    if not used or not 0 < pct <= 100:
        sys.exit("Aktif Claude oturumu yok ya da yüzde 1-100 arasında değil.")
    limit_k = max(1, round(used / (pct / 100) / 1000))
    settings.set_int("claude-token-limit", min(100000000, limit_k))
    Gio.Settings.sync()
    print(f"claude-token-limit = {limit_k}K  ({used / 1e6:.1f}M kullanılmış = %{pct:g})")


def main():
    locale.setlocale(locale.LC_ALL, "")
    if len(sys.argv) > 1 and sys.argv[1] == "claude-hooks":
        claude_hooks(sys.argv[2] if len(sys.argv) > 2 else "status")
        return
    settings, schema = open_settings()
    if len(sys.argv) > 2 and sys.argv[1] == "claude-calibrate":
        claude_calibrate(settings, sys.argv[2])
        return
    if len(sys.argv) > 1:
        if sys.argv[1] in ("-h", "--help", "help"):
            print(__doc__)
            return
        cli(settings, schema, sys.argv[1:])
        return
    if not sys.stdout.isatty():
        sys.exit("di-config: etkileşimli arayüz bir terminal gerektirir (ya da: di-config list).")
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(lambda scr: App(scr, settings, schema).run())


if __name__ == "__main__":
    main()
